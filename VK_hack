local emoteHopOn = false
local emoteSpeed = 80
local emoteTrack = nil
local emoteIds = {
	Dance1 = "rbxassetid://507771019",
	Dance2 = "rbxassetid://507776043",
	Dance3 = "rbxassetid://507777268",
	Stylish = "rbxassetid://3695333486",
}
local emoteChoice = "Dance1"
local emoteList = {"Dance1", "Dance2", "Dance3", "Stylish"}

local function stopEmoteHop()
	emoteHopOn = false
	if emoteTrack then
		pcall(function() emoteTrack:Stop() end)
		emoteTrack = nil
	end
end

local function startEmoteHop()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator") or hum
	pcall(function()
		if emoteTrack then emoteTrack:Stop() end
		local anim = Instance.new("Animation")
		anim.AnimationId = emoteIds[emoteChoice] or emoteIds.Dance1
		emoteTrack = animator:LoadAnimation(anim)
		emoteTrack.Looped = true
		emoteTrack:Play()
		emoteTrack:AdjustSpeed(emoteSpeed / 10)
	end)
end

local function openEmotePicker()
	openListPicker("Emote", emoteList, emoteChoice, function(n)
		emoteChoice = n
		if emoteHopOn then startEmoteHop() end
	end)
end

