			if v == n then skyIdx = i break end
		end
		if not skyOn then skyOn = true end
		applySky(true)
	end)
end

local function applyAutoBypass()
	pcall(function()
		local mt = getrawmetatable(game)
		if not mt then return end
		setreadonly(mt, false)
		local old = mt.__namecall
		mt.__namecall = newcclosure(function(self, ...)
			local method = getnamecallmethod()
			local m = typeof(method) == "string" and method or ""
			if m == "Kick" or m == "Ban" or m == "kick" or m == "ban" then return end
			if string.find(string.lower(m), "kick") or m == "Shutdown" then return end
			if m == "FireServer" or m == "InvokeServer" then
				local n = ""
				pcall(function() n = string.lower(tostring(self.Name)) end)
				if string.find(n, "kick") or string.find(n, "ban") or string.find(n, "anticheat") or string.find(n, "detect") then
					return
				end
			end
			return old(self, ...)
		end)
		setreadonly(mt, true)
	end)
	pcall(function()
		for _, v in pairs(game:GetService("CoreGui"):GetChildren()) do
			if v.Name == "RobloxPromptGui" then
				local prompt = v:FindFirstChild("promptOverlay", true)
				if prompt then prompt.Visible = false end
			end
		end
	end)
	task.spawn(function()
		pcall(function()
			local tags = {"anticheat", "ac", "detection", "ban", "kick", "security", "moderation"}
			local function proc(o)
				pcall(function()
					if o:IsA("LocalScript") or o:IsA("ModuleScript") then
						local ok, nm = pcall(function() return string.lower(o.Name) end)
						if ok and nm then
							for i = 1, #tags do
								if string.find(nm, tags[i], 1, true) then
									pcall(function() o.Disabled = true end)
									break
								end
							end
						end
					end
				end)
			end
			for _, o in ipairs(game:GetDescendants()) do proc(o) end
			game.DescendantAdded:Connect(proc)
		end)
	end)
	pcall(function()
		local fake = Instance.new("RemoteEvent")
		fake.Name = "ClientAlert"
		fake.Parent = LocalPlayer
		local pmt = getrawmetatable(LocalPlayer)
		if pmt then
			local oldnc = pmt.__namecall
			setreadonly(pmt, false)
			pmt.__namecall = newcclosure(function(self, ...)
				if getnamecallmethod() == "WaitForChild" and select(1, ...) == "ClientAlert" then
					return fake
				end
				return oldnc(self, ...)
			end)
			setreadonly(pmt, true)
		end
	end)
	print("[VK] Auto AC ON")
end
pcall(applyAutoBypass)
task.defer(function() pcall(applyAutoBypass) end)


