		local vy = cam and cam.ViewportSize.Y or 600
		local x, y = 80, 200
		if found then
			x = found.AbsolutePosition.X
			y = found.AbsolutePosition.Y + found.AbsoluteSize.Y + 2
		end
		-- if would go off bottom, open UPWARD instead
		if y + h > vy - 8 then
			y = math.max(8, (found and found.AbsolutePosition.Y or y) - h - 2)
		end
		if x + w > vx - 8 then
			x = math.max(8, vx - w - 8)
